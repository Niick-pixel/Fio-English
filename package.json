{
  "name": "english-coach",
  "productName": "English Coach",
  "version": "1.0.0",
  "description": "Entrenador de inglés corporativo (B2+ → C1) para macOS. 100% offline.",
  "main": "main.js",
  "author": "Fio",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "validate-content": "node scripts/validate-content.js",
    "dist": "electron-builder --mac --arm64",
    "dist:dir": "electron-builder --mac --arm64 --dir",
    "icon": "python3 scripts/make-icon.py"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.fio.englishcoach",
    "productName": "English Coach",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "content",
        "to": "content"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "English Coach usa el micrófono para grabar tus respuestas en el simulador de entrevista. Las grabaciones se guardan solo en tu Mac."
      },
      "icon": "build/icon.png"
    },
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "dmg": {
      "title": "English Coach",
      "contents": [
        {
          "x": 150,
          "y": 200
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 600,
        "height": 400
      }
    }
  }
}
